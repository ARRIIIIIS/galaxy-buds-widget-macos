<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GalaxyBudsClient.Interface.Controls"
             xmlns:pages="clr-namespace:GalaxyBudsClient.Interface.ViewModels.Pages"
             xmlns:ext="clr-namespace:GalaxyBudsClient.Interface.MarkupExtensions"
             xmlns:config="clr-namespace:GalaxyBudsClient.Model.Config"
             xmlns:i18N="clr-namespace:GalaxyBudsClient.Generated.I18N"
             mc:Ignorable="d" d:DesignWidth="800"
             x:Class="GalaxyBudsClient.Interface.Pages.PosturePage"
             x:DataType="pages:PosturePageViewModel"
             x:CompileBindings="True">

    <Design.DataContext>
        <pages:PosturePageViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="8" Margin="{StaticResource AppPageMargin}">

            <Border Classes="Card" ClipToBounds="True" Padding="24,20">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{ext:Translate {x:Static i18N:Keys.PagePosture}}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PitchDegrees, StringFormat={}{0:F1}°}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{ext:Translate {x:Static i18N:Keys.PosturePitchLabel}}"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <controls:SettingsGroup>
                <Interaction.Behaviors>
                    <ext:RequiresConnectedDeviceBehavior />
                </Interaction.Behaviors>

                <controls:SettingsSwitchItem Content="{ext:Translate {x:Static i18N:Keys.PostureEnable}}"
                                             Description="{ext:Translate {x:Static i18N:Keys.PostureEnableDesc}}"
                                             Symbol="Accessibility"
                                             IsClickEnabled="True"
                                             IsChecked="{Binding PostureMonitorEnabled, Source={x:Static config:Settings.Data}}" />

                <controls:SettingsSymbolItem Content="{ext:Translate {x:Static i18N:Keys.PostureCalibrate}}"
                                             Description="{ext:Translate {x:Static i18N:Keys.PostureCalibrateDesc}}"
                                             Symbol="TargetArrow"
                                             ActionSymbol="ArrowReset"
                                             IsClickEnabled="True"
                                             Click="OnCalibrateClicked" />

                <controls:SettingsSliderItem Content="{ext:Translate {x:Static i18N:Keys.PostureTriggerAngle}}"
                                             Description="{ext:Translate {x:Static i18N:Keys.PostureTriggerAngleDesc}}"
                                             Symbol="Gauge"
                                             Minimum="5"
                                             Maximum="40"
                                             Debounce="True"
                                             Value="{Binding PostureTriggerAngle, Source={x:Static config:Settings.Data}}" />

                <controls:SettingsSliderItem Content="{ext:Translate {x:Static i18N:Keys.PostureBlurIntensity}}"
                                             Description="{ext:Translate {x:Static i18N:Keys.PostureBlurIntensityDesc}}"
                                             Symbol="Blur"
                                             Minimum="0"
                                             Maximum="100"
                                             Debounce="True"
                                             Value="{Binding PostureBlurIntensity, Source={x:Static config:Settings.Data}}" />

                <controls:SettingsDescriptionItem Title="{ext:Translate {x:Static i18N:Keys.PostureHowItWorks}}"
                                                  Subtitle="{ext:Translate {x:Static i18N:Keys.PostureHowItWorksDesc}}"
                                                  Symbol="Info" />
            </controls:SettingsGroup>
        </StackPanel>
    </ScrollViewer>
</UserControl>
